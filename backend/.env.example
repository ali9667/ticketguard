NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://ticketguard:ticketguard@localhost:5432/ticketguard?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-character-key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
JWT_ISSUER=ticketguard-api
JWT_AUDIENCE=ticketguard-client
LOG_LEVEL=info
