generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EVENT_ORGANIZER
  SCANNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

enum TicketStatus {
  ISSUED
  ACTIVE
  TRANSFER_PENDING
  TRANSFERRED
  USED
  CANCELLED
  EXPIRED
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum NotificationType {
  TRANSFER_RECEIVED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_EXPIRED
  TICKET_TRANSFERRED
  TICKET_VERIFIED
  SECURITY_ALERT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AuditAction {
  USER_REGISTERED
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGED
  TICKET_ISSUED
  TICKET_TRANSFER_STARTED
  TICKET_TRANSFER_ACCEPTED
  TICKET_TRANSFER_REJECTED
  TICKET_TRANSFER_EXPIRED
  TICKET_VERIFIED
  TICKET_USED
  TICKET_CANCELLED
  USER_SUSPENDED
  ADMIN_ACTION
  ORDER_CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
}

enum SecurityEventType {
  FAILED_LOGIN
  INVALID_QR
  TRANSFER_ABUSE
  EXCESSIVE_REQUESTS
  REFRESH_TOKEN_REUSE
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                       String              @id @default(uuid())
  email                    String              @unique
  passwordHash             String              @map("password_hash")
  firstName                String              @map("first_name")
  lastName                 String              @map("last_name")
  role                     UserRole            @default(USER)
  status                   UserStatus          @default(ACTIVE)
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  deletedAt                DateTime?           @map("deleted_at")
  events                   Event[]             @relation("EventOrganizer")
  ownedTickets             Ticket[]            @relation("TicketOwner")
  initiatedTransfers       Transfer[]          @relation("TransferInitiator")
  receivedTransfers        Transfer[]          @relation("TransferRecipient")
  transferRecipientRecords TransferRecipient[]
  refreshTokens            RefreshToken[]
  notifications            Notification[]
  auditLogs                AuditLog[]          @relation("AuditActor")
  securityEvents           SecurityEvent[]     @relation("SecurityActor")
  scannerAssignments       ScannerAssignment[]
  idempotencyKeys          IdempotencyKey[]
  orders                   Order[]

  @@index([status])
  @@map("users")
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  address   String   @db.VarChar(500)
  city      String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  events    Event[]

  @@map("venues")
}

model Event {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(255)
  description        String?
  venueId            String              @map("venue_id") @db.Uuid
  startAt            DateTime            @map("start_at")
  endAt              DateTime            @map("end_at")
  timezone           String              @db.VarChar(100)
  capacity           Int
  status             EventStatus         @default(DRAFT)
  createdBy          String              @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  venue              Venue               @relation(fields: [venueId], references: [id])
  organizer          User                @relation("EventOrganizer", fields: [createdBy], references: [id])
  ticketTypes        TicketType[]
  tickets            Ticket[]
  scannerAssignments ScannerAssignment[]
  orderItems        OrderItem[]

  @@index([createdBy])
  @@index([venueId])
  @@index([status, startAt])
  @@map("events")
}

model TicketType {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @map("event_id") @db.Uuid
  name      String           @db.VarChar(100)
  price     Decimal          @db.Decimal(12, 2)
  currency  String           @db.Char(3)
  quantity  Int
  soldCount Int              @default(0) @map("sold_count")
  status    TicketTypeStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  orderItems OrderItem[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId, status])
  @@map("ticket_types")
}

model Ticket {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  ticketTypeId String             @map("ticket_type_id") @db.Uuid
  orderItemId  String?            @map("order_item_id") @db.Uuid
  ownerId      String             @map("owner_id") @db.Uuid
  ticketNumber String             @unique @map("ticket_number") @db.VarChar(80)
  status       TicketStatus       @default(ISSUED)
  issuedAt     DateTime           @default(now()) @map("issued_at")
  usedAt       DateTime?          @map("used_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  event        Event              @relation(fields: [eventId], references: [id])
  ticketType   TicketType         @relation(fields: [ticketTypeId, eventId], references: [id, eventId])
  owner        User               @relation("TicketOwner", fields: [ownerId], references: [id])
  orderItem    OrderItem?         @relation(fields: [orderItemId], references: [id])
  credentials  TicketCredential[]
  transfers    Transfer[]

  @@index([ownerId, status])
  @@index([eventId, status])
  @@index([ticketTypeId])
  @@index([orderItemId])
  @@map("tickets")
}

model TicketCredential {
  id               String           @id @default(uuid()) @db.Uuid
  ticketId         String           @map("ticket_id") @db.Uuid
  identifier       String           @unique @db.VarChar(64)
  secretHash       String           @map("secret_hash") @db.VarChar(128)
  secretCiphertext String           @map("secret_ciphertext") @db.Text
  status           CredentialStatus @default(ACTIVE)
  issuedAt         DateTime         @default(now()) @map("issued_at")
  revokedAt        DateTime?        @map("revoked_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  ticket           Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ticketId, status])
  @@map("ticket_credentials")
}

model Transfer {
  id              String             @id @default(uuid()) @db.Uuid
  ticketId        String             @map("ticket_id") @db.Uuid
  initiatorId     String             @map("initiator_id") @db.Uuid
  recipientId     String             @map("recipient_id") @db.Uuid
  status          TransferStatus     @default(PENDING)
  expiresAt       DateTime           @map("expires_at")
  acceptedAt      DateTime?          @map("accepted_at")
  rejectedAt      DateTime?          @map("rejected_at")
  cancelledAt     DateTime?          @map("cancelled_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  ticket          Ticket             @relation(fields: [ticketId], references: [id])
  initiator       User               @relation("TransferInitiator", fields: [initiatorId], references: [id])
  recipient       User               @relation("TransferRecipient", fields: [recipientId], references: [id])
  recipientRecord TransferRecipient?

  @@index([ticketId, status])
  @@index([recipientId, status])
  @@index([status, expiresAt])
  @@map("transfers")
}

model TransferRecipient {
  id          String   @id @default(uuid()) @db.Uuid
  transferId  String   @unique @map("transfer_id") @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  email       String   @db.VarChar(320)
  createdAt   DateTime @default(now()) @map("created_at")
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  recipient   User     @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@map("transfer_recipients")
}

model Order {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  status      OrderStatus   @default(PENDING)
  currency    String        @db.Char(3)
  subtotal    Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  expiresAt   DateTime?     @map("expires_at")
  user        User          @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  ticketTypeId  String    @map("ticket_type_id") @db.Uuid
  quantity      Int
  unitPrice     Decimal   @map("unit_price") @db.Decimal(12, 2)
  lineTotal     Decimal   @map("line_total") @db.Decimal(12, 2)
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         Event     @relation(fields: [eventId], references: [id])
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets       Ticket[]

  @@index([orderId])
  @@index([eventId, ticketTypeId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @unique @map("order_id") @db.Uuid
  provider    String        @db.VarChar(50)
  status      PaymentStatus @default(PENDING)
  providerRef String?       @unique @map("provider_ref") @db.VarChar(120)
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @db.Char(3)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  paidAt      DateTime?     @map("paid_at")
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("payments")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.VarChar(1000)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorId      String?     @map("actor_id") @db.Uuid
  action       AuditAction
  resourceType String      @map("resource_type") @db.VarChar(100)
  resourceId   String?     @map("resource_id") @db.Uuid
  requestId    String      @map("request_id") @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  actorId   String?           @map("actor_id") @db.Uuid
  type      SecurityEventType
  severity  SecuritySeverity
  requestId String            @map("request_id") @db.VarChar(128)
  ipAddress String?           @map("ip_address") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")
  actor     User?             @relation("SecurityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@map("security_events")
}

model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  key            String            @db.VarChar(255)
  userId         String            @map("user_id") @db.Uuid
  method         String            @db.VarChar(10)
  route          String            @db.VarChar(255)
  requestHash    String            @map("request_hash") @db.VarChar(128)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId, method, route])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ScannerAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("scanner_assignments")
}
